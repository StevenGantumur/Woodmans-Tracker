# Copy to .env and fill in your values.
# Read by both the Node API (backend/db.js) and the Python scripts (ml/config.py).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=woodmans_carts
DB_USER=postgres
DB_PASSWORD=your_password_here

# Optional overrides
# PORT=3001
# DEPOT_CORRAL=A
# MIN_CART_THRESHOLD=5
# PYTHON_BIN=python3
